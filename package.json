      "uuid": "11.1.1"
    },
    "@xmldom/xmldom": "0.8.13",
    "fast-xml-parser": "5.8.0",
    "node-jose": {
      "uuid": "11.1.1"
    },
    "tough-cookie": "4.1.3",
    "joi": "18.2.1",
    "lodash": "4.18.1",
    "lodash.pick": "3.1.0",
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "react-native": "0.73.11",
    "semver": "7.5.4",
    "serialize-javascript": "7.0.5",
